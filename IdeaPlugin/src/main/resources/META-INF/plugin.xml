<idea-plugin>
  <id>com.dslplatform.ideaplugin</id>
  <name>DSL Platform</name>
  <version>0.50.0</version>
  <vendor email="info@dsl-platform.com" url="https://dsl-platform.com">DSL Platform</vendor>

  <description><![CDATA[
      IDEA integration with DSL Platform.<br>
      <p>
        Provides syntax highlighting for the dsl files.
      </p>
      <p>
        Context-sensitive autocomplete is avilable via ctr + space or right click -> DSL.
      </p>
      <p>
        Region collapse available between extension points: { and }.
      </p>
      <em>dsl platform ddd</em>
    ]]></description>

  <change-notes><![CDATA[
    <ul>
      <li>0.50.0 Concept listing, autocomplete, folding, settings page
      <li>0.11.0 IDEA 2026 compatibility fix
      <li>0.10.1 IDEA 2024 compatibility fix
      <li>0.9.10 Highligting fix for IDEA 2020+
      <li>0.9.9 Bugfix
    </ul>
    ]]>
  </change-notes>

  <!-- please see https://confluence.jetbrains.com/display/IDEADEV/Build+Number+Ranges for description -->
  <idea-version since-build="223.0"/>

  <!-- please see https://confluence.jetbrains.com/display/IDEADEV/Plugin+Compatibility+with+IntelliJ+Platform+Products
       on how to target different products -->
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Add your extensions here -->
    <fileType name="DSL file" implementationClass="com.dslplatform.ideaplugin.DslFileType" fieldName="INSTANCE" language="DomainSpecificationLanguage" extensions="dsl" />
    <lang.parserDefinition language="DomainSpecificationLanguage" implementationClass="com.dslplatform.ideaplugin.DslParserDefinition"/>
    <lang.syntaxHighlighterFactory language="DomainSpecificationLanguage" implementationClass="com.dslplatform.ideaplugin.DslSyntaxHighlighterFactory"/>
    <lang.foldingBuilder language="DomainSpecificationLanguage" implementationClass="com.dslplatform.ideaplugin.DslFoldingBuilder"/>
    <colorSettingsPage implementation="com.dslplatform.ideaplugin.DslColorSettingsPage"/>
    <lang.commenter language="DomainSpecificationLanguage" implementationClass="com.dslplatform.ideaplugin.DslCommenter"/>
    <completion.contributor language="DomainSpecificationLanguage" implementationClass="com.dslplatform.ideaplugin.DslCompletionContributor"/>
    <editorFactoryListener implementation="com.dslplatform.ideaplugin.DslHoverListener"/>
    <applicationService serviceImplementation="com.dslplatform.ideaplugin.DslSettings"/>
    <applicationConfigurable parentId="tools" id="com.dslplatform.ideaplugin.settings"
                             instance="com.dslplatform.ideaplugin.DslSettingsPage" displayName="DSL Platform"/>
    <postStartupActivity implementation="com.dslplatform.ideaplugin.DslShortcutInitializer"/>
  </extensions>

  <actions>
    <action id="dsl.ListAvailableConcepts"
            class="com.dslplatform.ideaplugin.ListAvailableConceptsAction"
            text="List available concepts (DSL)"
            description="Show the rules available at the caret in a DSL file">
    </action>

    <group id="dsl.DslConceptsMenu"
           class="com.dslplatform.ideaplugin.DslConceptsMenuGroup"
           text="DSL"
           description="Rules available at the caret (DSL)"
           popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </group>
  </actions>

</idea-plugin>
